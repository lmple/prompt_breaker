cabal-version:      3.0
name:               backend
version:            0.1.0.0
build-type:         Simple

executable attack-harness
  default-language: GHC2021
  hs-source-dirs:   app, src
  main-is:          Main.hs
  ghc-options:      -Wall -Werror -threaded
  other-modules:
    DSL.OWASP
    DSL.Sanitizer
    DSL.Attack
    DSL.Prompt
    Runner.LLM
    Runner.Evaluator
    DB.Schema
    DB.Queries
    API.Types
    API.Routes
    API.Handlers
  build-depends:
      base            >= 4.18 && < 5
    , servant         >= 0.20
    , servant-server  >= 0.20
    , warp            >= 3.3
    , aeson           >= 2.1
    , text            >= 2.0
    , uuid            >= 1.3
    , postgresql-simple >= 0.7
    , req             >= 3.13
    , http-client     >= 0.7
    , wai-cors        >= 0.2
    , time            >= 1.12
    , bytestring      >= 0.11
    , case-insensitive >= 1.2
    , http-types      >= 0.12
    , wai             >= 3.2
    , modern-uri      >= 0.3
